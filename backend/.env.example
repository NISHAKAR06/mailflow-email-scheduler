# ── Backend ──────────────────────────────────────
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://mailflow:mailflow_secret@localhost:5432/mailflow

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Ethereal Email (generate at https://ethereal.email/create)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_ethereal_user@ethereal.email
SMTP_PASS=your_ethereal_password

# Rate Limiting
MAX_EMAILS_PER_HOUR=100
MAX_EMAILS_PER_HOUR_PER_SENDER=50

# Worker
WORKER_CONCURRENCY=3
MIN_SEND_DELAY_MS=500

# JWT (must match NextAuth secret)
JWT_SECRET=your-nextauth-secret-here

# Slack OAuth
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
